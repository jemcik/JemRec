<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose draws everything, so the platform theme only has to stay out of
      the way: no action bar, and a DayNight parent so the window background
      behind the Compose surface matches the system setting during startup.
      DeviceDefault.DayNight exists from API 29 and minSdk here is 31.
    -->
    <style name="Theme.JemRec" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!--
      TurnOffQuestionActivity: only its dialog is drawn, over whatever was
      open when the tile was tapped, so the window itself is see-through.
    -->
    <style name="Theme.JemRec.Question" parent="Theme.JemRec">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
