<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of JemRec's leaves this phone this way: not to a cloud backup, and
  not to a new phone in a device-to-device transfer. allowBackup="false" alone
  stops the first only (Android 12 and later). What would travel is this
  phone's own: its ADB key, the recorder's token, the setup state - which on
  another phone would only mark a setup done that never happened there.
  Recordings are ordinary files in a shared folder, and travel as those do.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
